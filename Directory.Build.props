<Project>
  <!--
    Independent NuGet versions (the models package has no dependencies, so engine releases
    never force a models release). Edit here and keep build/00-common.linq in sync.
  -->
  <PropertyGroup>
    <SdcbSimdGcdrNetVersion Condition="'$(SdcbSimdGcdrNetVersion)' == ''">2.0.0</SdcbSimdGcdrNetVersion>
    <SdcbSimdGcdrNetModelsVersion Condition="'$(SdcbSimdGcdrNetModelsVersion)' == ''">1.0.0</SdcbSimdGcdrNetModelsVersion>
    <!-- Engine package (exact pin: the library builds against engine internals). UseLocalSimdOnnx=true
         switches to ../Sdcb.SimdOnnx as a project reference for side-by-side development. -->
    <SdcbSimdOnnxVersion Condition="'$(SdcbSimdOnnxVersion)' == ''">0.1.0-preview.1</SdcbSimdOnnxVersion>
    <SimdOnnxProject>$(MSBuildThisFileDirectory)..\Sdcb.SimdOnnx\src\Sdcb.SimdOnnx\Sdcb.SimdOnnx.csproj</SimdOnnxProject>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
    <RootNamespace>Sdcb.$(MSBuildProjectName)</RootNamespace>
    <AssemblyName>Sdcb.$(MSBuildProjectName)</AssemblyName>
    <PackageId>Sdcb.$(MSBuildProjectName)</PackageId>
    <Authors>sdcb</Authors>
    <Company>Sdcb</Company>
    <PackageProjectUrl>https://github.com/sdcb/SimdGcdrNet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sdcb/SimdGcdrNet.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageTags>Sdcb;GCDRNet;document;document-enhancement;shadow-removal;image-enhancement;onnx;deep-learning</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' or '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Sdcb.SimdGcdrNet'">
    <PackageId>Sdcb.SimdGcdrNet</PackageId>
    <Version>$(SdcbSimdGcdrNetVersion)</Version>
    <IsPackable>true</IsPackable>
    <Description>Pure C# GCDRNet inference: document image shadow removal / appearance enhancement. Self-contained ONNX graph engine with CPU SIMD (AVX-512/AVX2/NEON/Vector) and GPU (Vulkan, Metal) backends; no onnxruntime dependency. Accepts interleaved BGR24 / RGB24 / BGRA32 / RGBA32. Models ship separately in Sdcb.SimdGcdrNet.Models.</Description>
    <PackageTags>Sdcb;GCDRNet;document;document-enhancement;shadow-removal;image-enhancement;onnx;inference;deep-learning;SIMD;AVX512;NEON;wasm;AOT;Vulkan;Metal;linqpad-samples</PackageTags>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Sdcb.SimdGcdrNet.Models'">
    <PackageId>Sdcb.SimdGcdrNet.Models</PackageId>
    <Version>$(SdcbSimdGcdrNetModelsVersion)</Version>
    <IsPackable>true</IsPackable>
    <!-- follows the upstream GCDRNet weights (THIRD-PARTY-NOTICES.txt); the engine stays Apache-2.0 -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>Embedded GCDRNet ONNX models (GC-Net + DR-Net) for Sdcb.SimdGcdrNet, no dependencies: GcdrEnhancer.FromBytes(GcdrModels.GcNet, GcdrModels.DrNet), zero-copy, with no model files to deploy.</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Copyright>Copyright (c) sdcb</Copyright>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <!-- a project-local README.md (e.g. the models package) wins over the repo README -->
    <None Condition="!Exists('$(MSBuildProjectDirectory)\README.md')" Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="README.md" Visible="false" />
    <None Condition="Exists('$(MSBuildProjectDirectory)\README.md')" Include="$(MSBuildProjectDirectory)\README.md" Pack="true" PackagePath="README.md" />
    <None Include="$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="THIRD-PARTY-NOTICES.txt" Visible="false" />
    <!-- regenerate with tools/gen_icon.py -->
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="icon.png" Visible="false" />
  </ItemGroup>
</Project>
