<Project>
  <!--
    Independent NuGet versions. Edit here and keep build/00-common.linq in sync.
    Pack with these properties, not -p:Version= (a global Version would also become the
    Sdcb.SimdGcdrNet dependency version of the models package).
  -->
  <PropertyGroup>
    <SdcbSimdGcdrNetVersion Condition="'$(SdcbSimdGcdrNetVersion)' == ''">0.1.0</SdcbSimdGcdrNetVersion>
    <SdcbSimdGcdrNetModelsVersion Condition="'$(SdcbSimdGcdrNetModelsVersion)' == ''">1.0.0</SdcbSimdGcdrNetModelsVersion>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
    <RootNamespace>Sdcb.$(MSBuildProjectName)</RootNamespace>
    <AssemblyName>Sdcb.$(MSBuildProjectName)</AssemblyName>
    <PackageId>Sdcb.$(MSBuildProjectName)</PackageId>
    <Authors>sdcb</Authors>
    <Company>Sdcb</Company>
    <PackageProjectUrl>https://github.com/sdcb/SimdGcdrNet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sdcb/SimdGcdrNet.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageTags>Sdcb;GCDRNet;document;shadow-removal;image-enhancement;SIMD</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' or '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Sdcb.SimdGcdrNet'">
    <PackageId>Sdcb.SimdGcdrNet</PackageId>
    <Version>$(SdcbSimdGcdrNetVersion)</Version>
    <IsPackable>true</IsPackable>
    <Description>Pure C# GCDRNet inference: document image shadow removal / appearance enhancement. Self-contained ONNX graph engine with CPU SIMD (AVX-512/AVX2/NEON/Vector) and GPU (Vulkan, Metal) backends; no onnxruntime dependency. Accepts interleaved BGR24 / RGB24 / BGRA32 / RGBA32. Models ship separately in Sdcb.SimdGcdrNet.Models.</Description>
    <PackageTags>Sdcb;GCDRNet;document;shadow-removal;image-enhancement;SIMD;Vulkan;Metal;linqpad-samples</PackageTags>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Sdcb.SimdGcdrNet.Models'">
    <PackageId>Sdcb.SimdGcdrNet.Models</PackageId>
    <Version>$(SdcbSimdGcdrNetModelsVersion)</Version>
    <IsPackable>true</IsPackable>
    <Description>Embedded GCDRNet ONNX models (GC-Net + DR-Net) for Sdcb.SimdGcdrNet: GcdrModels.CreateEnhancer() with no model files to deploy.</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="README.md" Visible="false" />
  </ItemGroup>
</Project>
