#version 450
#extension GL_GOOGLE_include_directive : require
#include "et.glsl"
// Concat along an axis: one dispatch per input. Copies this input's slice into
// dst at axisOffset.  dst[o, a, i] = src[o, a - axisOff, i].
layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer X { ET x[]; };
layout(set = 0, binding = 1) writeonly buffer O { ET o[]; };

layout(push_constant) uniform PC {
    uint n;          // src element count
    uint inner;      // product of dims after axis
    uint srcAxis;    // src extent on axis
    uint dstAxis;    // dst extent on axis
    uint axisOff;    // dst offset of this input on axis
} p;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.n) return;
    uint ii = i % p.inner;
    uint a = (i / p.inner) % p.srcAxis;
    uint oi = i / (p.inner * p.srcAxis);
    o[(oi * p.dstAxis + a + p.axisOff) * p.inner + ii] = x[i];
}
