#version 450
#extension GL_GOOGLE_include_directive : require
#include "et.glsl"
// Elementwise binary + fused activation, contiguous same-shape fast path (4 floats/thread).
// op: 0 add 1 sub 2 mul 3 div;  act: 0 none 1 relu 2 sigmoid
layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer A { ET4 a[]; };
layout(set = 0, binding = 1) readonly buffer B { ET4 b[]; };
layout(set = 0, binding = 2) writeonly buffer O { ET4 o[]; };

layout(push_constant) uniform PC { uint nv4; uint op, act; } p;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.nv4) return;
    vec4 va = vec4(a[i]), vb = vec4(b[i]), v;
    if (p.op == 0u) v = va + vb;
    else if (p.op == 1u) v = va - vb;
    else if (p.op == 2u) v = va * vb;
    else v = va / vb;
    if (p.act == 1u) v = max(v, vec4(0.0));
    else if (p.act == 2u) v = 1.0 / (1.0 + exp(-v));
    o[i] = ET4(v);
}
