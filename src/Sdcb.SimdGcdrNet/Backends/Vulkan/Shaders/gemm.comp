#version 450
#extension GL_GOOGLE_include_directive : require
#include "et.glsl"
// Tiled GEMM: C[M,N] = A[M,K] * B + bias[N]; B is [K,N] or [N,K] when transB.
// Tile 64x64, K-chunk 16, 256 threads -> 4x4 each.
layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer A  { ET a[]; };
layout(set = 0, binding = 1) readonly buffer B  { ET b[]; };
layout(set = 0, binding = 2) readonly buffer BS { float bs[]; };  // bias[N] (dummy if none)
layout(set = 0, binding = 3) writeonly buffer O { ET o[]; };

layout(push_constant) uniform PC {
    uint m, n, k;
    uint flags;     // bit0 transB, bit1 hasBias, bit2 relu, bit3 gelu
} p;

const uint BM = 64u, BN = 64u, BK = 16u;
shared float As[BK * BM];
shared float Bs[BK * BN];

float ferf(float v)
{
    float s = v < 0.0 ? -1.0 : 1.0;
    float ax = abs(v);
    float t = 1.0 / (1.0 + 0.3275911 * ax);
    float poly = ((((1.061405429 * t - 1.453152027) * t + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t;
    return (1.0 - poly * exp(-ax * ax)) * s;
}

void main()
{
    uint m0 = gl_WorkGroupID.y * BM;
    uint n0 = gl_WorkGroupID.x * BN;
    uint tid = gl_LocalInvocationID.x;
    uint ty = tid >> 4, tx = tid & 15u;
    bool transB = (p.flags & 1u) != 0u;

    float acc[4][4];
    for (int i = 0; i < 4; i++) for (int j = 0; j < 4; j++) acc[i][j] = 0.0;

    for (uint k0 = 0u; k0 < p.k; k0 += BK)
    {
        for (uint e = tid; e < BK * BM; e += 256u)
        {
            uint kk = e >> 6, mm = e & 63u;
            uint gm = m0 + mm, gk = k0 + kk;
            As[e] = (gm < p.m && gk < p.k) ? float(a[gm * p.k + gk]) : 0.0;
        }
        for (uint e = tid; e < BK * BN; e += 256u)
        {
            uint kk = e >> 6, nn = e & 63u;
            uint gn = n0 + nn, gk = k0 + kk;
            float v = 0.0;
            if (gn < p.n && gk < p.k)
                v = float(transB ? b[gn * p.k + gk] : b[gk * p.n + gn]);
            Bs[e] = v;
        }
        barrier();
        for (uint kk = 0u; kk < BK; kk++)
        {
            float av[4], bv[4];
            for (int i = 0; i < 4; i++) av[i] = As[kk * BM + ty * 4u + uint(i)];
            for (int j = 0; j < 4; j++) bv[j] = Bs[kk * BN + tx * 4u + uint(j)];
            for (int i = 0; i < 4; i++)
                for (int j = 0; j < 4; j++)
                    acc[i][j] += av[i] * bv[j];
        }
        barrier();
    }

    bool hasBias = (p.flags & 2u) != 0u;
    for (int i = 0; i < 4; i++)
    {
        uint gm = m0 + ty * 4u + uint(i);
        if (gm >= p.m) continue;
        for (int j = 0; j < 4; j++)
        {
            uint gn = n0 + tx * 4u + uint(j);
            if (gn >= p.n) continue;
            float v = acc[i][j];
            if (hasBias) v += bs[gn];
            if ((p.flags & 4u) != 0u) v = max(v, 0.0);
            if ((p.flags & 8u) != 0u) v = 0.5 * v * (1.0 + ferf(v * 0.7071067811865475));
            o[gm * p.n + gn] = ET(v);
        }
    }
}
