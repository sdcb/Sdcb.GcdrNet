#version 450
// Fast 2D matrix transpose [R,C] -> [C,R] via a 32x32 shared tile.
// Covers NCHW->NHWC (perm 0,2,3,1 on [1,C,H,W]) and rank-3 swaps (perm 0,2,1).
layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer X { float x[]; };
layout(set = 0, binding = 1) writeonly buffer O { float o[]; };

layout(push_constant) uniform PC { uint R, C; } p;

shared float tile[32 * 33];

void main()
{
    uint c0 = gl_WorkGroupID.x * 32u;   // input-col tile base
    uint r0 = gl_WorkGroupID.y * 32u;   // input-row tile base
    uint tx = gl_LocalInvocationID.x & 31u, ty = gl_LocalInvocationID.x >> 5; // ty 0..7
    for (uint i = 0u; i < 4u; i++)
    {
        uint r = r0 + ty + i * 8u, c = c0 + tx;
        float v = (r < p.R && c < p.C) ? x[r * p.C + c] : 0.0;
        tile[(ty + i * 8u) * 33u + tx] = v;   // tile[r_local][c_local]
    }
    barrier();
    for (uint i = 0u; i < 4u; i++)
    {
        uint c = c0 + ty + i * 8u, r = r0 + tx;
        if (c < p.C && r < p.R)
            o[c * p.R + r] = tile[tx * 33u + ty + i * 8u];
    }
}
