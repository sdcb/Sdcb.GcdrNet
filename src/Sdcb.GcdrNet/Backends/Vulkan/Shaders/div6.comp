#version 450
// Build DR-Net input: dst[0..3hw] = src; dst[3hw..6hw] = clamp(src/max(shadow,1e-6),0,1).
layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer X { float x[]; };
layout(set = 0, binding = 1) readonly buffer S { float s[]; };
layout(set = 0, binding = 2) writeonly buffer O { float o[]; };

layout(push_constant) uniform PC { uint hw; } p;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= 3u * p.hw) return;
    o[i] = x[i];
    float v = x[i] / max(s[i], 1e-6);
    o[3u * p.hw + i] = clamp(v, 0.0, 1.0);
}
