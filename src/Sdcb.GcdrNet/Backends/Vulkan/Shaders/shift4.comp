#version 450
#extension GL_GOOGLE_include_directive : require
#include "et.glsl"
// shift.comp with 4 channels per invocation (c and every group end % 4 == 0).
layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer X { ET4 x[]; };
layout(set = 0, binding = 1) writeonly buffer O { ET4 o[]; };

layout(push_constant) uniform PC {
    uint c, h, w, axis;
    uint ge0, ge1, ge2, ge3, ge4;     // group end channel indices
    int  of0, of1, of2, of3, of4;     // per-group offsets
} p;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    uint c4 = p.c >> 2;
    if (i >= c4 * p.h * p.w) return;
    uint q = i % c4, px = i / c4, ch = q * 4u;
    uint ox = px % p.w, oy = px / p.w;
    int off = ch < p.ge0 ? p.of0 : ch < p.ge1 ? p.of1 : ch < p.ge2 ? p.of2 : ch < p.ge3 ? p.of3 : ch < p.ge4 ? p.of4 : 0;
    int sy = int(oy), sx = int(ox);
    if (p.axis == 2u) sy += off; else sx += off;
    o[i] = (uint(sy) < p.h && uint(sx) < p.w) ? x[(uint(sy) * p.w + uint(sx)) * c4 + q] : ET4(0.0);
}
