#version 450
#extension GL_GOOGLE_include_directive : require
#include "et.glsl"
// Generic rank<=4 permute: dst flat idx -> src idx via permuted in-strides.
layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer X { ET x[]; };
layout(set = 0, binding = 1) writeonly buffer O { ET o[]; };

layout(push_constant) uniform PC {
    uint n;
    uint os0, os1, os2;          // out strides (os3 = 1)
    uint ps0, ps1, ps2, ps3;     // in strides in out-dim order: inStr[perm[k]]
} p;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.n) return;
    uint d0 = i / p.os0, r0 = i % p.os0;
    uint d1 = r0 / p.os1, r1 = r0 % p.os1;
    uint d2 = r1 / p.os2, d3 = r1 % p.os2;
    o[i] = x[d0 * p.ps0 + d1 * p.ps1 + d2 * p.ps2 + d3 * p.ps3];
}
