#version 450
// Rank-4 pad on all dims (spatial in practice), constant or reflect.
layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer X { float x[]; };
layout(set = 0, binding = 1) writeonly buffer O { float o[]; };

layout(push_constant) uniform PC {
    uint id0, id1, id2, id3;     // in dims
    uint od0, od1, od2, od3;     // out dims
    uint pb0, pb1, pb2, pb3;     // pad before per dim
    uint mode;                   // 0 const 1 reflect
    float value;
} p;

int mirror(int i, int d) { while (i < 0 || i >= d) i = i < 0 ? -i : 2 * d - 2 - i; return i; }
int coord(uint oidx, uint pb, uint idim, out bool miss)
{
    int s = int(oidx) - int(pb);
    if (uint(s) >= idim)
    {
        if (p.mode == 0u) { miss = true; return 0; }
        s = mirror(s, int(idim));
    }
    miss = false; return s;
}

void main()
{
    uint i = gl_GlobalInvocationID.x;
    uint n = p.od0 * p.od1 * p.od2 * p.od3;
    if (i >= n) return;
    uint s2 = p.od3, s1 = p.od2 * s2, s0 = p.od1 * s1;
    uint d0 = i / s0, r0 = i % s0;
    uint d1 = r0 / s1, r1 = r0 % s1;
    uint d2 = r1 / s2, d3 = r1 % s2;
    bool m0, m1, m2, m3;
    int c0 = coord(d0, p.pb0, p.id0, m0);
    int c1 = coord(d1, p.pb1, p.id1, m1);
    int c2 = coord(d2, p.pb2, p.id2, m2);
    int c3 = coord(d3, p.pb3, p.id3, m3);
    if (m0 || m1 || m2 || m3) { o[i] = p.value; return; }
    uint si2 = p.id3, si1 = p.id2 * si2, si0 = p.id1 * si1;
    o[i] = x[uint(c0) * si0 + uint(c1) * si1 + uint(c2) * si2 + uint(c3)];
}
