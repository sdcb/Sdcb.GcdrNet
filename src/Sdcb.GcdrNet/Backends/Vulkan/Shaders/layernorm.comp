#version 450
// LayerNorm over last dim: one workgroup (256 threads) per row.
// o[r,i] = (x[r,i] - mean) * rsqrt(var + eps) * w[i] + b[i]
layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer X { float x[]; };
layout(set = 0, binding = 1) readonly buffer W { float w[]; };
layout(set = 0, binding = 2) readonly buffer B { float b[]; };
layout(set = 0, binding = 3) writeonly buffer O { float o[]; };

layout(push_constant) uniform PC { uint len; float eps; } p;

shared float red[256];

void main()
{
    uint row = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    uint base = row * p.len;

    float s = 0.0, s2 = 0.0;
    for (uint i = tid; i < p.len; i += 256u)
    {
        float v = x[base + i];
        s += v; s2 += v * v;
    }
    red[tid] = s;
    barrier();
    for (uint st = 128u; st > 0u; st >>= 1)
    {
        if (tid < st) red[tid] += red[tid + st];
        barrier();
    }
    float mean = red[0] / float(p.len);
    barrier();
    red[tid] = s2;
    barrier();
    for (uint st = 128u; st > 0u; st >>= 1)
    {
        if (tid < st) red[tid] += red[tid + st];
        barrier();
    }
    float inv = inversesqrt(red[0] / float(p.len) - mean * mean + p.eps);
    for (uint i = tid; i < p.len; i += 256u)
        o[base + i] = (x[base + i] - mean) * inv * w[i] + b[i];
}
