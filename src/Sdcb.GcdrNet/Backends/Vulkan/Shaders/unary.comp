#version 450
// Elementwise unary: mode 0 relu, 1 sigmoid, 2 erf, 3 gelu, 4 copy
layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer X { float x[]; };
layout(set = 0, binding = 1) writeonly buffer O { float o[]; };

layout(push_constant) uniform PC { uint n, mode; } p;

float fexp(float v)
{
    v = clamp(v, -87.3, 88.7);
    float fx = v * 1.4426950408889634 + 0.5;
    float nf = floor(fx);
    float r = v - nf * 0.693359375 - nf * -0.00021219444005469058;
    float poly = (((((1.9875691500e-4 * r + 1.3981999507e-3) * r + 8.3334519073e-3) * r
        + 4.1665795894e-2) * r + 1.6666665459e-1) * r + 5.0000001201e-1) * r * r + r + 1.0;
    return poly * uintBitsToFloat((uint(int(nf)) + 127u) << 23);
}

float ferf(float v)
{
    float s = v < 0.0 ? -1.0 : 1.0;
    float ax = abs(v);
    float t = 1.0 / (1.0 + 0.3275911 * ax);
    float poly = ((((1.061405429 * t - 1.453152027) * t + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t;
    return (1.0 - poly * fexp(-ax * ax)) * s;
}

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.n) return;
    float v = x[i];
    float r;
    if (p.mode == 0u) r = max(v, 0.0);
    else if (p.mode == 1u) r = 1.0 / (1.0 + fexp(-v));
    else if (p.mode == 2u) r = ferf(v);
    else if (p.mode == 3u) r = 0.5 * v * (1.0 + ferf(v * 0.7071067811865475));
    else r = v;
    o[i] = r;
}
