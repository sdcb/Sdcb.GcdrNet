#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_control_flow_attributes : require
// Direct NHWC 3x3 conv for GPUs without cooperative matrices whose wide waves
// (Adreno: 64/128 lanes, 32 KB shared memory) starve on conv_tile's shared-memory
// staging: no shared memory, every operand is an f16vec4 load that the L1/texture
// cache serves. Each invocation computes TM consecutive output pixels of one row x
// TN*4 output channels; the TM*SW+2 input pixels of a kernel row are loaded once
// per 4 input channels and reused by the three kx taps. Invocations of one wave
// share pixels and step through oc (n4 fastest), so input loads broadcast and
// weight loads coalesce. Requires fp16 storage, ic % 4 == 0 and oc % (4*TN) == 0.
// Accumulation is fp32. Same push constants / weight layout ([K][OC], k = tap*IC + ic)
// as conv_tile.comp. Compile-time: -DSW= (1 or 2), -DTM=, -DTN=.
layout(local_size_x = 64) in;

layout(set = 0, binding = 0) readonly buffer X  { f16vec4 x[]; };
layout(set = 0, binding = 1) readonly buffer W  { f16vec4 w[]; };
layout(set = 0, binding = 2) readonly buffer B  { float b[]; };
layout(set = 0, binding = 3) readonly buffer R  { f16vec4 r[]; };
layout(set = 0, binding = 4) writeonly buffer O { f16vec4 o[]; };

layout(push_constant) uniform PC {
    uint ic, ih, iw;
    uint oc, oh, ow;
    uint kh, kw, sh, sw;
    uint pt, pl;
    uint flags;     // bit0 hasBias, bit1 reflectPad, bit2 relu, bit3 hasAdd, bit4 gelu
    uint pad0;
} p;

#ifndef SW
#define SW 1u
#endif
#ifndef TM
#define TM 4
#endif
#ifndef TN
#define TN 2
#endif
const int NX = (TM - 1) * int(SW) + 3;   // input pixels of one kernel row

int mirror(int i, int d) { if (d <= 1) return 0; while (i < 0 || i >= d) i = i < 0 ? -i : 2 * d - 2 - i; return i; }

float ferf(float v)
{
    float s = v < 0.0 ? -1.0 : 1.0;
    float ax = abs(v);
    float t = 1.0 / (1.0 + 0.3275911 * ax);
    float poly = ((((1.061405429 * t - 1.453152027) * t + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t;
    return (1.0 - poly * exp(-ax * ax)) * s;
}

vec4 gelu4(vec4 v)
{
    return vec4(0.5 * v.x * (1.0 + ferf(v.x * 0.7071067811865475)),
                0.5 * v.y * (1.0 + ferf(v.y * 0.7071067811865475)),
                0.5 * v.z * (1.0 + ferf(v.z * 0.7071067811865475)),
                0.5 * v.w * (1.0 + ferf(v.w * 0.7071067811865475)));
}

void main()
{
    uint ng = p.oc / uint(4 * TN);               // oc groups
    uint xg = (p.ow + uint(TM) - 1u) / uint(TM); // pixel groups per row
    uint gid = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    if (gid >= ng * xg * p.oh) return;
    uint g = gid % ng;
    uint t = gid / ng;
    uint xb = t % xg, oy = t / xg;
    uint ox0 = xb * uint(TM);
    uint c4 = p.ic >> 2, o4 = p.oc >> 2;
    uint n40 = g * uint(TN);
    bool reflect = (p.flags & 2u) != 0u;

    vec4 acc[TM * TN];
    [[unroll]] for (int i = 0; i < TM * TN; i++) acc[i] = vec4(0.0);

    // input column per window slot (clamped / mirrored once; zero-pad slots masked)
    int sx0 = int(ox0 * SW) - int(p.pl);
    uint col[NX];
    bool cok[NX];
    [[unroll]] for (int i = 0; i < NX; i++)
    {
        int sx = sx0 + i;
        cok[i] = reflect || uint(sx) < p.iw;
        if (reflect && uint(sx) >= p.iw) sx = mirror(sx, int(p.iw));
        col[i] = uint(clamp(sx, 0, int(p.iw) - 1));
    }

    // no `continue`: Adreno 750 mis-executed a `continue` in this ky loop (one accumulator
    // of the 4x2 tile was lost) and in depthwise's tap loop; zero-pad rows are masked loads
    for (uint ky = 0u; ky < 3u; ky++)
    {
        int sy = int(oy * p.sh + ky) - int(p.pt);
        bool rok = reflect || uint(sy) < p.ih;
        sy = reflect ? mirror(sy, int(p.ih)) : clamp(sy, 0, int(p.ih) - 1);
        uint rowBase = uint(sy) * p.iw;
        uint wk = ky * 3u * p.ic;                // k of (ky, kx = 0, ci = 0)
        for (uint ci = 0u; ci < c4; ci++)
        {
            vec4 xs[NX];
            [[unroll]] for (int i = 0; i < NX; i++)
                xs[i] = cok[i] && rok ? vec4(x[(rowBase + col[i]) * c4 + ci]) : vec4(0.0);
            [[unroll]] for (uint kx = 0u; kx < 3u; kx++)
            {
                uint wrow = (wk + kx * p.ic + ci * 4u) * o4 + n40;
                [[unroll]] for (int j = 0; j < TN; j++)
                {
                    vec4 w0 = vec4(w[wrow + uint(j)]);
                    vec4 w1 = vec4(w[wrow + o4 + uint(j)]);
                    vec4 w2 = vec4(w[wrow + 2u * o4 + uint(j)]);
                    vec4 w3 = vec4(w[wrow + 3u * o4 + uint(j)]);
                    [[unroll]] for (int m = 0; m < TM; m++)
                    {
                        vec4 a = xs[m * int(SW) + int(kx)];
                        acc[m * TN + j] += a.x * w0 + a.y * w1 + a.z * w2 + a.w * w3;
                    }
                }
            }
        }
    }

    bool hasBias = (p.flags & 1u) != 0u;
    bool relu = (p.flags & 4u) != 0u;
    bool hasAdd = (p.flags & 8u) != 0u;
    bool gelu = (p.flags & 16u) != 0u;
    [[unroll]] for (int j = 0; j < TN; j++)
    {
        uint n4 = n40 + uint(j);
        uint oc0 = n4 * 4u;
        vec4 bias = hasBias ? vec4(b[oc0], b[oc0 + 1u], b[oc0 + 2u], b[oc0 + 3u]) : vec4(0.0);
        [[unroll]] for (int m = 0; m < TM; m++)
        {
            uint ox = ox0 + uint(m);
            if (ox < p.ow)
            {
                uint oi = (oy * p.ow + ox) * o4 + n4;
                vec4 v = acc[m * TN + j] + bias;
                if (hasAdd) v += vec4(r[oi]);
                if (relu) v = max(v, vec4(0.0));
                if (gelu) v = gelu4(v);
                o[oi] = f16vec4(v);
            }
        }
    }
}