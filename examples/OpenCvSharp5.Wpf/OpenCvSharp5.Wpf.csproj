<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>OpenCvSharp5.Wpf</RootNamespace>
    <AssemblyName>OpenCvSharp5.Wpf</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- UI frameworks need culture data (Directory.Build.props turns it off for the libraries). -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Sdcb.SimdGcdrNet\Sdcb.SimdGcdrNet.csproj" />
    <ProjectReference Include="..\..\src\Sdcb.SimdGcdrNet.Models\Sdcb.SimdGcdrNet.Models.csproj" />
    <PackageReference Include="OpenCvSharp5" Version="5.0.0.20261012" />
    <PackageReference Include="OpenCvSharp5.runtime.win" Version="5.0.0.20261012" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\example.jpg" Link="example.jpg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
